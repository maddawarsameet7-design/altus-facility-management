# ── Altsan Facility Management Platform Environment Configuration ──

# Django Core Settings
# Must be False in production
DEBUG=False

# Django Secret Key (Generate a cryptographically secure 50+ char random string)
SECRET_KEY=django-insecure-replace-with-secure-key-in-production

# Allowed Hosts (comma-separated list of hostnames / domains)
ALLOWED_HOSTS=api.altsan.com,altsan.com

# CORS Allowed Origins (comma-separated list of allowed web frontend URLs)
CORS_ALLOWED_ORIGINS=https://altsan.com,https://app.altsan.com

# Rate Limiting
# Strict default is 5/min in production; dev default is 60/min
LOGIN_THROTTLE_RATE=5/min

# Database Connection (Optional in dev, defaults to local PostgreSQL)
DATABASE_URL=postgres://postgres:password@localhost:5432/altus

# Frontend Settings (Vite)
# Production backend API base URL - can be specified with or without trailing slash and /api
# (e.g. https://api.altsan.com or https://api.altsan.com/api) - frontend api.js normalizes both to /api/
VITE_API_URL=https://api.altsan.com/api
