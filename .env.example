# ==============================================================================
# ALTUS MANAGED STAFFING PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# This document defines every required production environment variable, expected
# formatting, and the exact failure consequence if missing or misconfigured.
# ==============================================================================

# ── 1. Django Core & Security ────────────────────────────────────────────────
# DEBUG: Must be False in production. Defaults to False if unset.
# FAILURE CONSEQUENCE: If True in production, sensitive tracebacks and configuration
# are exposed in HTTP responses, and strict production startup checks are bypassed.
DEBUG=False

# SECRET_KEY: Cryptographically secure random secret key (minimum 32 characters).
# FAILURE CONSEQUENCE: Production startup aborts with ImproperlyConfigured if missing,
# shorter than 32 characters, or using known insecure/demo defaults.
SECRET_KEY=replace-with-minimum-32-character-cryptographically-secure-random-secret-key-123456

# ALLOWED_HOSTS: Comma-separated list of authorized fully-qualified hostnames.
# FAILURE CONSEQUENCE: Production startup aborts with ImproperlyConfigured if empty
# or wildcard [*]. HTTP requests with non-matching Host headers return HTTP 400 Bad Request.
ALLOWED_HOSTS=api.altsan.com,altsan.com

# CORS_ALLOWED_ORIGINS: Comma-separated list of exact web/mobile client origins allowed for CORS.
# FAILURE CONSEQUENCE: Production startup aborts with ImproperlyConfigured if empty when DEBUG=False.
# Web dashboards and mobile frontends cannot communicate with the backend API.
CORS_ALLOWED_ORIGINS=https://altsan.com,https://app.altsan.com

# ── 2. Database & Cache ───────────────────────────────────────────────────────
# DATABASE_URL: PostgreSQL connection string (postgres://user:password@host:port/dbname).
# FAILURE CONSEQUENCE: Production startup aborts with ImproperlyConfigured if missing or if the
# configured engine is not PostgreSQL. Silent fallback to SQLite is strictly forbidden when DEBUG=False.
DATABASE_URL=postgres://altus_user:secure_production_password@postgres-db.altsan.internal:5432/altus_production

# REDIS_URL: Redis server connection URL (redis://host:port/db).
# FAILURE CONSEQUENCE: Production startup aborts with ImproperlyConfigured if missing when DEBUG=False.
# Required for Django Channels WebSocket distribution, live staff coordination, and caching.
REDIS_URL=redis://redis-cache.altsan.internal:6379/1

# ── 3. Worker OTP Authentication Security ─────────────────────────────────────
# OTP_HMAC_SECRET: Dedicated cryptographic pepper key for HMAC-SHA256 OTP verification code hashing.
# FAILURE CONSEQUENCE: Production startup aborts with ImproperlyConfigured if missing or if identical
# to SECRET_KEY. Fallback to SECRET_KEY is strictly forbidden when DEBUG=False to prevent key reuse.
OTP_HMAC_SECRET=your_dedicated_otp_hmac_pepper_secret_minimum_32_chars_long!!

# ── 4. Private Object Storage ─────────────────────────────────────────────────
# PRIVATE_STORAGE_BUCKET: Name of the private cloud bucket (AWS S3 or compatible) used for
# storing geofenced clock-in selfies, housekeeping evidence photos, KYC files, and audit media.
# FAILURE CONSEQUENCE: Production startup aborts with ImproperlyConfigured if missing when DEBUG=False.
# Files must NEVER be stored on public links; all access is via short-lived signed URLs.
PRIVATE_STORAGE_BUCKET=altus-production-private-documents

# AWS Storage & S3 Settings (Required if storing files in AWS S3 or using AWS SNS)
# FAILURE CONSEQUENCE: Image uploads fail, inspection/complaint photos fail, and signed URL generation fails.
AWS_S3_REGION_NAME=ap-south-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# ── 5. SMS Provider & Rate Limits ─────────────────────────────────────────────
# SMS_PROVIDER: SMS dispatch provider. Must be 'TWILIO' or 'AWS_SNS'.
# FAILURE CONSEQUENCE: Production startup aborts with ImproperlyConfigured if missing or set to console.
SMS_PROVIDER=TWILIO

# SMS_BACKEND: Backend class. Use 'core.sms.ProductionSMSBackend' for production.
SMS_BACKEND=core.sms.ProductionSMSBackend

# Twilio SMS Credentials (Required if SMS_PROVIDER=TWILIO):
# FAILURE CONSEQUENCE: Production startup aborts with ImproperlyConfigured if TWILIO_ACCOUNT_SID,
# TWILIO_AUTH_TOKEN, or TWILIO_PHONE_NUMBER is missing when DEBUG=False. Workers cannot receive login OTPs.
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# SMS_DAILY_GLOBAL_CAP: Global daily SMS budget cap (defaults to 500).
# FAILURE CONSEQUENCE: At 80% of limit, alerts are dispatched to platform Directors. At 100%,
# further SMS dispatches are refused to prevent billing exhaustion.
SMS_DAILY_GLOBAL_CAP=500

# ── 6. Throttling & Rate Limiting ─────────────────────────────────────────────
# Production throttle rates applied automatically when DEBUG=False:
# - login: 5/min (user IP)
# - otp_request: 10/min
# - otp_verify: 15/min
# - clock_in / clock_out: 10/min
# - complaint_create: 20/min
# - supply_request_create: 20/min
LOGIN_THROTTLE_RATE=5/min

# ── 7. Reverse Proxy IP Configuration ─────────────────────────────────────────
# NUM_PROXIES: Number of reverse proxy hops (e.g. Cloudflare + Render = 1 or 2).
# FAILURE CONSEQUENCE: Client IP extraction for audit logs and throttles will be inaccurate if misconfigured.
NUM_PROXIES=1

# ── 8. Frontend Web App (Vite) ────────────────────────────────────────────────
# Base URL for frontend requests to the Django REST API backend.
VITE_API_URL=https://api.altsan.com/api
