# ==============================================================================
# ALTSAN MANAGED STAFFING PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ── 1. Django Core & Security ────────────────────────────────────────────────
# Must be False in production. If True, debug error pages and relaxed throttles are enabled.
DEBUG=False

# Minimum 32 cryptographically secure characters.
# Startup aborts with ImproperlyConfigured if missing, too short, or using known insecure defaults.
SECRET_KEY=replace-with-minimum-32-character-cryptographically-secure-random-secret-key-123456

# Comma-separated list of fully qualified hostnames allowed to serve requests.
# Startup aborts with ImproperlyConfigured if empty or wildcard [*].
ALLOWED_HOSTS=api.altsan.com,altsan.com

# Comma-separated list of exact frontend origins allowed for Cross-Origin requests.
# Startup aborts with ImproperlyConfigured if empty when DEBUG=False.
CORS_ALLOWED_ORIGINS=https://altsan.com,https://app.altsan.com

# ── 2. Database & Cache ───────────────────────────────────────────────────────
# Production PostgreSQL connection URL.
# If connection fails or credentials fail, logs warning and falls back to SQLite.
DATABASE_URL=postgres://postgres:secure_production_password@postgres-db.altsan.internal:5432/altsan_production

# Redis connection URL for Django Channels WebSocket messaging and shared caching.
# If missing, falls back to InMemoryChannelLayer.
REDIS_URL=redis://redis-cache.altsan.internal:6379/1

# ── 3. Private Object Storage ─────────────────────────────────────────────────
# Required for storing geofenced clock-in selfies, worker KYC documents, and audit media.
# Files are served strictly via time-limited signed URLs or supervisor permission checks.
# Startup aborts with ImproperlyConfigured if missing when DEBUG=False.
PRIVATE_STORAGE_BUCKET=altsan-production-private-documents

# ── 4. SMS Provider & Worker OTP Authentication ──────────────────────────────
# SMS Provider choice: 'TWILIO' or 'AWS_SNS'.
# Startup aborts with ImproperlyConfigured if missing or set to console backend when DEBUG=False.
SMS_PROVIDER=TWILIO

# Backend class path (use 'core.sms.ProductionSMSBackend' for production, 'core.sms.ConsoleSMSBackend' for local dev).
SMS_BACKEND=core.sms.ProductionSMSBackend

# Global daily SMS dispatch cap to prevent budget runaway and rogue automated exhaustion.
# Warning notification sent to Platform Director at 80%; hard cutoff enforced at 100%. Defaults to 500.
SMS_DAILY_GLOBAL_CAP=500

# Twilio SMS Credentials (Required if SMS_PROVIDER=TWILIO)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# AWS SNS Configuration (Required if SMS_PROVIDER=AWS_SNS)
AWS_S3_REGION_NAME=ap-south-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Pepper secret for HMAC-SHA256 OTP verification code hashing.
# If not set, system securely falls back to SECRET_KEY.
OTP_HMAC_SECRET=your_dedicated_otp_hmac_pepper_secret_minimum_32_chars

# ── 5. Throttling & Rate Limiting ─────────────────────────────────────────────
# Strict brute-force protection rate limits per user/IP.
LOGIN_THROTTLE_RATE=5/min

# ── 6. Frontend Configuration (Vite) ──────────────────────────────────────────
# Production backend API base URL for web portal.
VITE_API_URL=https://api.altsan.com/api
