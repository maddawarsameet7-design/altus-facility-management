# Altsan Marketing Site — Environment Variables Template

# Base URLs
PUBLIC_SITE_URL=https://altsan.com
APP_URL=https://app.altsan.com

# Deployment Flags
STAGING=false
ENVIRONMENT=production

# Email Dispatch Provider (Resend or SendGrid)
RESEND_API_KEY=re_your_api_key_here
CONTACT_RECIPIENT_EMAIL=inquiries@altsan.com

# Cloudflare Turnstile Bot Protection
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAx...
TURNSTILE_SECRET_KEY=0x4AAAAAAAx...

# Analytics (Optional — Loaded strictly after visitor cookie consent)
# For Google Analytics, use G-XXXXX. For Plausible, use altsan.com.
PUBLIC_ANALYTICS_ID=
