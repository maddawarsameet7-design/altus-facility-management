---
import { siteConfig } from '../config/site';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA'; // Cloudflare test key default
---

<div class="contact-form-wrapper">
  <form id="contact-form" class="contact-form" novalidate>
    <!-- Honeypot anti-spam field -->
    <div style="display: none;" aria-hidden="true">
      <label for="contact-website-hp">Leave this empty</label>
      <input type="text" id="contact-website-hp" name="b_website_hp" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Submission timestamp token -->
    <input type="hidden" name="form_ts" id="form_ts" value="" />

    <!-- Name & Email (2 cols on desktop) -->
    <div class="form-row">
      <div class="form-group">
        <label for="name" class="form-label">Full Name <span class="req">*</span></label>
        <input
          type="text"
          id="name"
          name="name"
          required
          maxlength="100"
          class="form-input"
          placeholder="e.g. Ramesh Kulkarni"
          autocomplete="name"
        />
        <span class="field-error" id="name-error"></span>
      </div>

      <div class="form-group">
        <label for="email" class="form-label">Email Address <span class="req">*</span></label>
        <input
          type="email"
          id="email"
          name="email"
          required
          maxlength="100"
          class="form-input"
          placeholder="e.g. chairman@greensociety.org"
          autocomplete="email"
        />
        <span class="field-error" id="email-error"></span>
      </div>
    </div>

    <!-- Phone & Facility Name -->
    <div class="form-row">
      <div class="form-group">
        <label for="phone" class="form-label">Phone Number <span class="req">*</span></label>
        <input
          type="tel"
          id="phone"
          name="phone"
          required
          maxlength="20"
          class="form-input"
          placeholder="e.g. +91 98230 00000"
          autocomplete="tel"
        />
        <span class="field-error" id="phone-error"></span>
      </div>

      <div class="form-group">
        <label for="organization" class="form-label">Society or Facility Name <span class="req">*</span></label>
        <input
          type="text"
          id="organization"
          name="organization"
          required
          maxlength="100"
          class="form-input"
          placeholder="e.g. Green Meadows Co-op Housing Society"
        />
        <span class="field-error" id="organization-error"></span>
      </div>
    </div>

    <!-- Facility Type Selection -->
    <div class="form-group">
      <label for="facility_type" class="form-label">Facility Category <span class="req">*</span></label>
      <select id="facility_type" name="facility_type" required class="form-select">
        <option value="" disabled selected>Select facility type</option>
        <option value="Residential Housing Society">Residential Housing Society / Apartment Complex</option>
        <option value="Healthcare Facility / Clinic">Hospital, Clinic, or Diagnostic Lab</option>
        <option value="Commercial Office / IT Park">Commercial Office / IT Space</option>
        <option value="Educational Institution">School / Educational Campus</option>
        <option value="Other Commercial Space">Other Commercial / Industrial Facility</option>
      </select>
      <span class="field-error" id="facility_type-error"></span>
    </div>

    <!-- Message -->
    <div class="form-group">
      <label for="message" class="form-label">Staffing Requirements & Common-Area Details <span class="req">*</span></label>
      <textarea
        id="message"
        name="message"
        rows="4"
        required
        maxlength="2000"
        class="form-textarea"
        placeholder="Briefly describe your requirements: number of shifts, estimated cleaners required, area size (sq. ft.), or specific housekeeping needs..."
      ></textarea>
      <span class="field-error" id="message-error"></span>
      <div class="char-count"><span id="char-num">0</span> / 2000</div>
    </div>

    <!-- Cloudflare Turnstile Bot Protection -->
    <div class="turnstile-container">
      <div
        class="cf-turnstile"
        data-sitekey={turnstileSiteKey}
        data-callback="onTurnstileSuccess"
        data-theme="light"
      ></div>
      <input type="hidden" name="cf-turnstile-response" id="cf-turnstile-response" />
      <span class="field-error" id="turnstile-error"></span>
    </div>

    <!-- Privacy Consent Checkbox -->
    <div class="form-group consent-group">
      <label class="consent-label">
        <input type="checkbox" id="consent" name="consent" required class="form-checkbox" />
        <span>
          I consent to Altsan processing my contact details solely to respond to this staffing inquiry. Submissions are dispatched directly to operations email and are not stored in any external marketing database.
        </span>
      </label>
      <span class="field-error" id="consent-error"></span>
    </div>

    <!-- Submission Feedback Alerts -->
    <div id="form-alert" class="form-alert" role="alert" style="display: none;"></div>

    <!-- Submit Button -->
    <button type="submit" id="submit-btn" class="btn btn-primary submit-btn">
      <span class="btn-text">Send Staffing Inquiry</span>
      <span class="btn-spinner" style="display: none;">Sending...</span>
    </button>
  </form>
</div>

<!-- Load Cloudflare Turnstile script asynchronously -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script define:vars={{ fallbackEmail: siteConfig.email, fallbackPhone: siteConfig.phoneFormatted }}>
  (function () {
    const form = document.getElementById('contact-form');
    const formTs = document.getElementById('form_ts');
    const alertBox = document.getElementById('form-alert');
    const submitBtn = document.getElementById('submit-btn');
    const btnText = submitBtn.querySelector('.btn-text');
    const btnSpinner = submitBtn.querySelector('.btn-spinner');
    const msgInput = document.getElementById('message');
    const charNum = document.getElementById('char-num');

    // Stamp initial timestamp
    if (formTs) formTs.value = Date.now().toString();

    // Char counter
    if (msgInput && charNum) {
      msgInput.addEventListener('input', () => {
        charNum.textContent = msgInput.value.length.toString();
      });
    }

    // Global turnstile callback
    window.onTurnstileSuccess = function (token) {
      const input = document.getElementById('cf-turnstile-response');
      if (input) input.value = token;
      const err = document.getElementById('turnstile-error');
      if (err) err.textContent = '';
    };

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Clear errors
        document.querySelectorAll('.field-error').forEach((el) => (el.textContent = ''));
        if (alertBox) {
          alertBox.style.display = 'none';
          alertBox.className = 'form-alert';
          alertBox.textContent = '';
        }

        // Basic HTML5 validation
        let hasErrors = false;
        const requiredFields = ['name', 'email', 'phone', 'organization', 'facility_type', 'message'];
        for (const fieldId of requiredFields) {
          const input = document.getElementById(fieldId);
          const errorEl = document.getElementById(`${fieldId}-error`);
          if (input && !input.value.trim()) {
            if (errorEl) errorEl.textContent = 'This field is required.';
            hasErrors = true;
          }
        }

        const consent = document.getElementById('consent');
        const consentError = document.getElementById('consent-error');
        if (consent && !consent.checked) {
          if (consentError) consentError.textContent = 'Consent is required to submit this inquiry.';
          hasErrors = true;
        }

        if (hasErrors) return;

        // Collect Form Data
        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        // Lock button
        submitBtn.disabled = true;
        btnText.style.display = 'none';
        btnSpinner.style.display = 'inline';

        try {
          const response = await fetch('/api/contact', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json',
            },
            body: JSON.stringify(payload),
          });

          const result = await response.json().catch(() => ({}));

          if (response.ok && result.success) {
            form.reset();
            if (charNum) charNum.textContent = '0';
            alertBox.className = 'form-alert alert-success';
            alertBox.style.display = 'block';
            alertBox.innerHTML = `
              <strong>✓ Inquiry Sent Successfully!</strong><br />
              Thank you. Our facility operations team will review your requirements and respond within one business day.
            `;
          } else {
            const errorMsg = result.message || 'Unable to deliver inquiry right now.';
            alertBox.className = 'form-alert alert-error';
            alertBox.style.display = 'block';
            alertBox.innerHTML = `
              <strong>Notice:</strong> ${errorMsg}<br />
              Please contact our operations desk directly via email at <a href="mailto:${fallbackEmail}">${fallbackEmail}</a> or phone at <a href="tel:${fallbackPhone}">${fallbackPhone}</a>.
            `;
          }
        } catch (err) {
          alertBox.className = 'form-alert alert-error';
          alertBox.style.display = 'block';
          alertBox.innerHTML = `
            <strong>Submission Notice:</strong> Network error encountered while sending message.<br />
            Please reach us directly at <a href="mailto:${fallbackEmail}">${fallbackEmail}</a> or <a href="tel:${fallbackPhone}">${fallbackPhone}</a>.
          `;
        } finally {
          submitBtn.disabled = false;
          btnText.style.display = 'inline';
          btnSpinner.style.display = 'none';
        }
      });
    }
  })();
</script>

<style>
  .contact-form-wrapper {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 2.25rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.25rem;
  }

  .form-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-navy);
    margin-bottom: 0.4rem;
  }
  .req {
    color: var(--color-coral-dark);
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border: 1.5px solid var(--color-border);
    border-radius: 8px;
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--color-text-main);
    background-color: #ffffff;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--color-coral);
    box-shadow: 0 0 0 3px rgba(255, 107, 107, 0.15);
  }

  .field-error {
    font-size: 0.775rem;
    color: #DC2626;
    margin-top: 0.25rem;
    min-height: 1rem;
  }

  .char-count {
    font-size: 0.75rem;
    color: #94A3B8;
    text-align: right;
    margin-top: 0.2rem;
  }

  .turnstile-container {
    margin-bottom: 1.25rem;
    min-height: 65px;
  }

  .consent-group {
    margin-bottom: 1.5rem;
  }

  .consent-label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.825rem;
    color: var(--color-text-muted);
    line-height: 1.45;
    cursor: pointer;
  }

  .form-checkbox {
    margin-top: 0.2rem;
    accent-color: var(--color-coral);
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .form-alert {
    padding: 1rem 1.25rem;
    border-radius: 8px;
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }
  .alert-success {
    background-color: #ECFDF5;
    border: 1px solid #10B981;
    color: #065F46;
  }
  .alert-error {
    background-color: #FEF2F2;
    border: 1px solid #EF4444;
    color: #991B1B;
  }
  .alert-error a {
    color: #7F1D1D;
    font-weight: 600;
  }

  .submit-btn {
    width: 100%;
    padding: 0.9rem;
    font-size: 1rem;
  }

  @media (max-width: 680px) {
    .contact-form-wrapper {
      padding: 1.5rem 1rem;
    }
    .form-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>

