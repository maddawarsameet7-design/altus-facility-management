---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';

const pageTitle = `About Altsan: Managed Facility Staffing & Operations | ${siteConfig.name}`;
const pageDesc =
  'Learn about Altsan: our mission to bring accountability, verified workforce management, and digital transparency to housekeeping and facility operations.';
---

<Layout title={pageTitle} description={pageDesc} canonicalPath="/about">
  <header class="page-header">
    <div class="container text-center">
      <span class="eyebrow-light">Company Overview</span>
      <h1 class="page-title">Professionalizing Facility Operations Through Verification</h1>
      <p class="page-subtitle">
        We bridge the gap between hard-working cleaning crews and property management through structured training, fair compensation, and digital oversight.
      </p>
    </div>
  </header>

  <!-- Narrative Section -->
  <section class="section bg-white">
    <div class="container narrow">
      <div class="content-block">
        <span class="eyebrow">Our Mission</span>
        <h2>Why We Built Altsan</h2>
        <p>
          Facility management in residential and commercial properties has long been dominated by informal contractors operating with little transparency. Managing committees and facility managers face frequent absenteeism, skipped cleaning duties, and paper-based attendance registers that provide zero accountability.
        </p>
        <p>
          At the same time, frontline facility workers are frequently subjected to unpredictable wages, irregular hours, and a lack of structured operational support.
        </p>
        <p>
          <strong>Altsan was founded to replace this broken model.</strong> We directly employ and manage facility workers, providing them with structured onboarding, regular salaries, and digital tools. In return, clients receive reliable staffing, geofenced shift validation, and verifiable photo checklists.
        </p>
      </div>

      <div class="content-block">
        <span class="eyebrow">Operating Principles</span>
        <h2>Our Core Standards</h2>
        <div class="principles-grid">
          <div class="principle-item">
            <h3>1. Dignity of Labor & Fair Compliance</h3>
            <p>
              We believe quality facility upkeep starts with how frontline workers are treated. All staff undergo identity verification, receive safety gear and uniforms, and are compensated punctually through direct bank disbursements.
            </p>
          </div>

          <div class="principle-item">
            <h3>2. Verification Over Assumptions</h3>
            <p>
              We do not ask clients to trust vague promises. Every shift is tied to GPS geofencing, key tasks require photo evidence, and physical spot audits are conducted by experienced field supervisors.
            </p>
          </div>

          <div class="principle-item">
            <h3>3. Transparent Problem Resolution</h3>
            <p>
              When a cleaner is unwell or an area needs recleaning, our supervisors step in immediately. We take responsibility for resolving operational hitches rather than passing excuses to the committee.
            </p>
          </div>
        </div>
      </div>

      <div class="content-block">
        <span class="eyebrow">Service Scope</span>
        <h2>Specialization & Boundaries</h2>
        <p>
          Altsan is specialized strictly in housekeeping, common-area sanitation, and allied facility operations.
        </p>
        <div class="callout-box">
          <p>
            ℹ️ <strong>Scope Notice:</strong> {siteConfig.claims.psaraExclusionDisclaimer}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="cta-banner">
    <div class="container text-center">
      <h2>Work With an Accountable Facility Partner</h2>
      <p>
        Contact our team to discuss staffing for your residential complex or commercial property.
      </p>
      <div class="cta-btns">
        <a href="/contact" class="btn btn-primary">Connect With Operations</a>
        <a href="/how-it-works" class="btn btn-outline-light">How It Works</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background-color: var(--color-navy);
    color: #ffffff;
    padding: 4.5rem 0 3.5rem;
  }
  .eyebrow-light {
    display: inline-block;
    color: var(--color-coral);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }
  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  .page-subtitle {
    font-size: 1.1rem;
    color: #CBD5E1;
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .section {
    padding: 4.5rem 0;
  }
  .bg-white {
    background-color: #ffffff;
  }
  .narrow {
    max-width: 780px;
  }

  .content-block {
    margin-bottom: 3.5rem;
  }
  .content-block:last-child {
    margin-bottom: 0;
  }

  .eyebrow {
    color: var(--color-coral-dark);
    font-size: 0.825rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
    display: inline-block;
  }

  .content-block h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 1rem;
  }
  .content-block p {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }

  .principles-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .principle-item {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.5rem;
  }
  .principle-item h3 {
    font-size: 1.15rem;
    color: var(--color-navy);
    margin-bottom: 0.5rem;
  }
  .principle-item p {
    margin-bottom: 0;
    font-size: 0.925rem;
  }

  .callout-box {
    background: #F1F5F9;
    border-left: 4px solid var(--color-navy);
    padding: 1.25rem;
    border-radius: 4px;
    margin-top: 1rem;
  }
  .callout-box p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-main);
  }

  .cta-banner {
    background-color: var(--color-navy);
    color: #ffffff;
    padding: 4.5rem 0;
  }
  .cta-banner h2 {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }
  .cta-banner p {
    font-size: 1.05rem;
    color: #CBD5E1;
    margin-bottom: 2rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .cta-btns {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
    }
  }
</style>

