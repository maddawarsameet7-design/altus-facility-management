  <!-- Client-side Interactive Tabs & Hotspot Tour Script -->
  <script is:inline>
    // 1. Ecosystem Tabs Switcher
    const ecoTabs = document.querySelectorAll('.eco-tab');
    const ecoPanels = document.querySelectorAll('.eco-panel');

    ecoTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-tab');
        
        ecoTabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        ecoPanels.forEach(p => {
          p.classList.remove('active');
          p.style.display = 'none';
        });

        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        const targetPanel = document.getElementById(`panel-${targetId}`);
        if (targetPanel) {
          targetPanel.classList.add('active');
          targetPanel.style.display = 'block';
        }
      });
    });

    // 2. Campus Zone Hotspot Selector
    const zoneData = {
      lobby: {
        title: "Lobbies & High-Speed Elevators",
        freq: "Cleaned & Disinfected Every 3 Hours",
        protocol: [
          "Mirror sanitization and smudge removal with streak-free glass cleaner",
          "High-touch elevator buttons and handrail disinfection using hospital-grade sanitizers",
          "Entrance lobby floor dry-dusting and wet-mopping with neutral disinfectant",
          "Door handle, intercom panel, and security desk wipedown"
        ],
        timing: [
          "<strong>Pre-Office Hours:</strong> Deep clean completed by 07:30 AM before resident departure",
          "<strong>Mid-Day Refresh:</strong> High-touch wipe down at 12:30 PM & 04:30 PM",
          "<strong>Chemicals Used:</strong> Diversey Taski R1 & R2 (Eco-friendly, child & pet safe)",
          "<strong>Inspection:</strong> Route supervisor conducts UV-check spot audit weekly"
        ]
      },
      podium: {
        title: "Podium, Jogging Track & Children's Play Area",
        freq: "Daily Morning Sweep & Washdown",
        protocol: [
          "Complete dry-sweeping of jogging track, walkways, and seating gazebos",
          "High-pressure washdown of main entrance driveway and perimeter tiles",
          "Playground equipment sanitization and safety perimeter check",
          "Drain grating clearing to prevent monsoon and washdown water stagnation"
        ],
        timing: [
          "<strong>Early Morning Routine:</strong> 06:00 AM - 08:00 AM before walkers and children arrive",
          "<strong>Evening Trash Sweep:</strong> 05:00 PM litter patrol across benches and play areas",
          "<strong>Equipment:</strong> Heavy-duty outdoor floor scrubbers and pressure lances",
          "<strong>Supervisor Review:</strong> Weekly drainage and anti-skid safety inspection"
        ]
      },
      clubhouse: {
        title: "Clubhouse, Gym, Swimming Pool Deck & Indoor Games",
        freq: "Deep Sanitized Twice Daily",
        protocol: [
          "Gym equipment wipe-down with non-corrosive antibacterial disinfectant",
          "Poolside deck anti-skid floor scrubbing and scum line removal",
          "Clubhouse washrooms, shower stalls, and changing room deep sanitization",
          "Air-conditioning vent dusting and indoor sports floor vacuuming"
        ],
        timing: [
          "<strong>First Shift:</strong> 05:30 AM - 07:00 AM prior to early-morning gym sessions",
          "<strong>Second Shift:</strong> 02:00 PM - 04:00 PM prior to evening community recreation",
          "<strong>Chemicals Used:</strong> Taski R6 (toilet cleaner), Taski R9 (sanitizer), safe pH floor cleaners",
          "<strong>Audit:</strong> Water puddle elimination & aroma inspection logged by supervisor"
        ]
      },
      refuse: {
        title: "Garbage Chutes, Refuse Rooms & Central Waste Yard",
        freq: "Daily Clearance & Disinfection",
        protocol: [
          "Floor-by-floor garbage chute hopper sanitation and odor control treatment",
          "Wet, Dry, and Hazardous waste segregation audit before municipal collection",
          "Garbage bin high-pressure washing with heavy-duty antibacterial wash",
          "Flies and pest prevention powder application around central compactor yard"
        ],
        timing: [
          "<strong>Collection Timing:</strong> 07:00 AM - 09:30 AM coordinated with PMC/PCMC trucks",
          "<strong>Post-Handover Scrub:</strong> Complete bin and floor washdown by 10:30 AM",
          "<strong>Compliance:</strong> Enforces Solid Waste Management Rules 2016 for bulk waste generators",
          "<strong>Record:</strong> Daily waste handover weight and photo logged on society portal"
        ]
      }
    };

    const zoneButtons = document.querySelectorAll('.zone-btn');
    const displayTitle = document.getElementById('zone-display-title');
    const displayFreq = document.getElementById('zone-display-freq');
    const displayProtocol = document.getElementById('zone-display-protocol');
    const displayTiming = document.getElementById('zone-display-timing');

    zoneButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const zoneKey = btn.getAttribute('data-zone');
        const data = zoneData[zoneKey];
        if (!data) return;

        zoneButtons.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        if (displayTitle) displayTitle.textContent = data.title;
        if (displayFreq) displayFreq.textContent = data.freq;

        if (displayProtocol) {
          displayProtocol.innerHTML = data.protocol.map(item => `<li>${item}</li>`).join('');
        }

        if (displayTiming) {
          displayTiming.innerHTML = data.timing.map(item => `<li>${item}</li>`).join('');
        }
      });
    });
  </script>
