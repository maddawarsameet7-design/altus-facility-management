---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';

const pageTitle = `Managed Facility Staffing & Housekeeping Operations | ${siteConfig.name}`;
const pageDesc =
  'Altsan deploys verified, trained housekeeping personnel to housing societies, hospitals, and commercial properties with geofenced mobile attendance and photo-verified task checklists.';
---

<Layout title={pageTitle} description={pageDesc} canonicalPath="/">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-grid">
        <!-- Left: Value Proposition & CTAs -->
        <div class="hero-content">
          <div class="hero-badge">
            <span class="pulse-dot"></span>
            <span>Pune & PCMC Verified Operations</span>
          </div>

          <h1 class="hero-title">
            Managed Housekeeping & Staffing <span class="gradient-text">You Can Verify</span>
          </h1>

          <p class="hero-subtitle">
            We deploy dedicated, KYC-onboarded cleaning personnel to housing societies, clinics, and commercial premises. Every shift is tracked with hardware geofencing, real-time selfie check-ins, and timestamped photo task checklists.
          </p>

          <div class="hero-ctas">
            <a href="/contact" class="btn btn-primary btn-lg">
              <span>Request Staffing Proposal</span>
              <svg class="btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/housekeeping" class="btn btn-outline-light btn-lg">View Cleaning Scope</a>
          </div>

          <!-- Micro-Trust Indicators -->
          <div class="hero-trust-row">
            <div class="trust-item">
              <svg class="trust-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>100% Police & Aadhaar Verified</span>
            </div>
            <div class="trust-item">
              <svg class="trust-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>Hardware Geofence Check-in</span>
            </div>
            <div class="trust-item">
              <svg class="trust-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2.5"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
              <span>Automated Reliever Backup</span>
            </div>
          </div>
        </div>

        <!-- Right: Interactive Device & Live Operations Showcase -->
        <div class="hero-visual">
          <div class="phone-mockup-wrapper">
            
            <!-- Floating Badge: Top Right -->
            <div class="floating-badge badge-top">
              <div class="badge-icon-box bg-green">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              </div>
              <div class="badge-text">
                <span class="badge-title">Zero Phantom Billing</span>
                <span class="badge-sub">100% Geofenced Shift Fulfillment</span>
              </div>
            </div>

            <!-- The Smartphone Mockup Frame -->
            <div class="phone-frame">
              <div class="phone-notch">
                <div class="notch-speaker"></div>
                <div class="notch-camera"></div>
              </div>

              <div class="phone-screen">
                <!-- App Header -->
                <div class="app-header">
                  <div class="app-brand">
                    <span class="app-logo-dot"></span>
                    <span class="app-title">Altsan Worker</span>
                  </div>
                  <div class="app-society-pill">📍 Baner Meadows CHS</div>
                </div>

                <!-- Live Shift Card -->
                <div class="app-shift-card">
                  <div class="shift-card-header">
                    <div class="worker-avatar-box">
                      <span class="avatar-text">RS</span>
                      <span class="avatar-status-dot"></span>
                    </div>
                    <div class="shift-worker-info">
                      <div class="worker-name">Ramesh Shinde</div>
                      <div class="worker-role">Housekeeping Lead • Morning</div>
                    </div>
                    <div class="shift-time-badge">07:00 - 15:30</div>
                  </div>

                  <div class="geofence-status-banner">
                    <div class="geofence-indicator">
                      <span class="gps-pulse"></span>
                      <span class="geofence-text">Inside Property Boundary</span>
                    </div>
                    <span class="geofence-accuracy">GPS Accuracy: 6m</span>
                  </div>
                </div>

                <!-- Daily Checklist Header -->
                <div class="app-checklist-title">
                  <span>Shift Task Checklist</span>
                  <span class="checklist-progress">2 of 3 Done</span>
                </div>

                <!-- Checklist Items -->
                <div class="app-checklist">
                  <!-- Task 1 -->
                  <div class="task-card task-done">
                    <div class="task-check-icon">✓</div>
                    <div class="task-details">
                      <div class="task-name">Lobby & Lift Sanitization (Tower A)</div>
                      <div class="task-meta">
                        <span class="task-time">07:42 AM</span>
                        <span class="photo-pill">📸 Photo Verified</span>
                      </div>
                    </div>
                  </div>

                  <!-- Task 2 -->
                  <div class="task-card task-done">
                    <div class="task-check-icon">✓</div>
                    <div class="task-details">
                      <div class="task-name">Clubhouse & Gym Floor Washdown</div>
                      <div class="task-meta">
                        <span class="task-time">08:35 AM</span>
                        <span class="photo-pill">📸 Photo Verified</span>
                      </div>
                    </div>
                  </div>

                  <!-- Task 3 -->
                  <div class="task-card task-active">
                    <div class="task-spinner"></div>
                    <div class="task-details">
                      <div class="task-name">Refuse Room & Waste Bin Clearance</div>
                      <div class="task-meta">
                        <span class="task-in-progress">In Progress • Capturing Proof</span>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- App Action Button -->
                <div class="app-action-footer">
                  <div class="app-btn-mock">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                    <span>Tap to Capture Task Photo</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Floating Badge: Bottom Left -->
            <div class="floating-badge badge-bottom">
              <div class="badge-icon-box bg-coral">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <div class="badge-text">
                <span class="badge-title">Reliever Deployed in 12m</span>
                <span class="badge-sub">Automated absence replacement</span>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Impact & Proof Metrics Strip -->
  <section class="metrics-strip">
    <div class="container">
      <div class="metrics-grid">
        <div class="metric-card">
          <div class="metric-val">99.4<span class="metric-unit">%</span></div>
          <div class="metric-label">Shift Fulfillment Rate</div>
          <div class="metric-sub">Automated reliever dispatch on sick days</div>
        </div>
        <div class="metric-card">
          <div class="metric-val">0</div>
          <div class="metric-label">Phantom Billing Disputes</div>
          <div class="metric-sub">100% geofence-verified on-site hours</div>
        </div>
        <div class="metric-card">
          <div class="metric-val">100<span class="metric-unit">%</span></div>
          <div class="metric-label">Police & KYC Verified</div>
          <div class="metric-sub">Full Aadhaar & address proof on file</div>
        </div>
        <div class="metric-card">
          <div class="metric-val">&lt; 15<span class="metric-unit">m</span></div>
          <div class="metric-label">Supervisor Response Time</div>
          <div class="metric-sub">Dedicated on-field route supervisors</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem & Solution Overview -->
  <section class="section py-5 bg-white">
    <div class="container">
      <div class="section-header text-center">
        <span class="eyebrow">The Operational Difference</span>
        <h2 class="section-title">Accountable Facility Management, Not Unmonitored Labor</h2>
        <p class="section-lead">
          Traditional contractors frequently leave housing societies and commercial facilities with unannounced absenteeism, missed cleaning zones, and disputed billings. Altsan integrates supervisory oversight directly with real-time operational software.
        </p>
      </div>

      <div class="grid grid-3">
        <!-- Pillar 1 -->
        <div class="card">
          <div class="card-icon">📍</div>
          <h3 class="card-title">Geofenced Shift Attendance</h3>
          <p class="card-text">
            Workers check in and out through our mobile application only within the physical geofence boundary of your property. Roster entries reflect real on-site hours, preventing phantom billing and unauthorized absences.
          </p>
          <a href="/how-it-works" class="card-link">Learn about roster tracking →</a>
        </div>

        <!-- Pillar 2 -->
        <div class="card">
          <div class="card-icon">📸</div>
          <h3 class="card-title">Photo-Verified Task Execution</h3>
          <p class="card-text">
            Cleaning checklists for lobbies, stairwells, clubhouses, and waste disposal areas require timestamped photo evidence upon completion. Supervisors conduct scheduled spot audits to ensure hygiene standards are maintained.
          </p>
          <a href="/housekeeping" class="card-link">Review cleaning standards →</a>
        </div>

        <!-- Pillar 3 -->
        <div class="card">
          <div class="card-icon">🔄</div>
          <h3 class="card-title">Structured Reliever Workflow</h3>
          <p class="card-text">
            When staff members take planned leave or report unexpected sick days, our supervisors trigger structured replacement requests to mobilize eligible backup personnel and maintain required headcounts.
          </p>
          <a href="/for-societies" class="card-link">Explore society workflows →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================================
       SECTION 5: CONTRACTOR VS ALTSAN BATTLECARD
       ========================================================================== -->
  <section class="section py-5 battlecard-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="eyebrow">The Real Operational Difference</span>
        <h2 class="section-title">Why Housing Societies Fire Traditional Contractors</h2>
        <p class="section-lead">
          Unorganized contractors rely on unmonitored labor, phantom muster rolls, and constant excuses. Altsan provides software-verified facility staffing with guaranteed reliever backup.
        </p>
      </div>

      <div class="battlecard-container">
        <!-- Traditional Contractor Card -->
        <div class="battlecard battlecard-legacy">
          <div class="battlecard-badge legacy-badge">Traditional Contractor</div>
          <h3 class="battlecard-title">Unmonitored & Disputed</h3>
          <p class="battlecard-desc">The daily reality of unorganized staffing agencies in Pune & PCMC</p>
          <ul class="battlecard-list">
            <li class="battlecard-item item-fail">
              <span class="battle-icon">✕</span>
              <div>
                <strong>Ghost Workers & Disputed Bills:</strong>
                <span>Paper registers signed without proof lead to monthly invoices for cleaners who were never actually on-site.</span>
              </div>
            </li>
            <li class="battlecard-item item-fail">
              <span class="battle-icon">✕</span>
              <div>
                <strong>Monday Absenteeism Chaos:</strong>
                <span>Staff members disappear without notice on critical days, leaving podiums, lobbies, and clubhouses uncleaned.</span>
              </div>
            </li>
            <li class="battlecard-item item-fail">
              <span class="battle-icon">✕</span>
              <div>
                <strong>Zero Background Verification:</strong>
                <span>Random daily-wage laborers sent without police clearance or KYC, creating safety risks for gated communities.</span>
              </div>
            </li>
            <li class="battlecard-item item-fail">
              <span class="battle-icon">✕</span>
              <div>
                <strong>Committee Does the Quality Checks:</strong>
                <span>Secretaries and residents have to chase unmotivated cleaners and constantly report missed cleaning zones.</span>
              </div>
            </li>
            <li class="battlecard-item item-fail">
              <span class="battle-icon">✕</span>
              <div>
                <strong>Statutory Compliance Liabilities:</strong>
                <span>Missing PF, ESIC, and minimum wage documentation exposes Managing Committee members to direct legal notice.</span>
              </div>
            </li>
          </ul>
        </div>

        <!-- Altsan Managed Standard Card -->
        <div class="battlecard battlecard-altsan">
          <div class="battlecard-badge altsan-badge">★ The Altsan Standard</div>
          <h3 class="battlecard-title">Software-Verified & Accountable</h3>
          <p class="battlecard-desc">Designed specifically for managing committees requiring transparent operations</p>
          <ul class="battlecard-list">
            <li class="battlecard-item item-pass">
              <span class="battle-icon">✓</span>
              <div>
                <strong>Hardware Geofenced Check-In:</strong>
                <span>Workers can only clock in inside your physical society boundary. You only ever pay for verified, on-site hours.</span>
              </div>
            </li>
            <li class="battlecard-item item-pass">
              <span class="battle-icon">✓</span>
              <div>
                <strong>15-Minute Guaranteed Reliever Dispatch:</strong>
                <span>When a team member reports sick, our local area supervisor network immediately mobilizes a verified standby reliever.</span>
              </div>
            </li>
            <li class="battlecard-item item-pass">
              <span class="battle-icon">✓</span>
              <div>
                <strong>100% Police & Aadhaar Verified:</strong>
                <span>Permanent address, Aadhaar KYC, and police clearance verified and stored digitally before any worker steps on your property.</span>
              </div>
            </li>
            <li class="battlecard-item item-pass">
              <span class="battle-icon">✓</span>
              <div>
                <strong>Timestamped Photo Checklists:</strong>
                <span>Every lift, lobby, and garbage room is photographed after cleaning and audited against standardized hygiene rubrics.</span>
              </div>
            </li>
            <li class="battlecard-item item-pass">
              <span class="battle-icon">✓</span>
              <div>
                <strong>100% Statutory Compliance Pack:</strong>
                <span>Official PF/ESIC challans and minimum wage slips delivered with every invoice for transparent society audits.</span>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================================
       SECTION 3: 3-WAY OPERATIONS ECOSYSTEM
       ========================================================================== -->
  <section class="section py-5 bg-white ecosystem-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="eyebrow">The 3-Way Operations Ecosystem</span>
        <h2 class="section-title">One Connected System. Total Peace of Mind.</h2>
        <p class="section-lead">
          Altsan connects the Society Managing Committee, our on-ground Cleaning Crew, and Area Route Supervisors into one synchronized platform.
        </p>
      </div>

      <!-- Tab Switcher -->
      <div class="ecosystem-tabs" role="tablist">
        <button class="eco-tab active" data-tab="committee" role="tab" aria-selected="true">
          <span class="eco-tab-icon">🏢</span>
          <span class="eco-tab-text">Society Committee Portal</span>
        </button>
        <button class="eco-tab" data-tab="worker" role="tab" aria-selected="false">
          <span class="eco-tab-icon">📱</span>
          <span class="eco-tab-text">Worker Field App</span>
        </button>
        <button class="eco-tab" data-tab="supervisor" role="tab" aria-selected="false">
          <span class="eco-tab-icon">🛡️</span>
          <span class="eco-tab-text">Area Supervisor Command</span>
        </button>
      </div>

      <!-- Tab Panels -->
      <div class="ecosystem-panels">
        
        <!-- Panel 1: Committee Portal -->
        <div class="eco-panel active" id="panel-committee" role="tabpanel">
          <div class="panel-grid">
            <div class="panel-content">
              <div class="panel-badge">For Secretaries, Chairmen & Estate Managers</div>
              <h3>Real-Time Attendance & Quality Without Micromanagement</h3>
              <p>
                No more frantic morning phone calls checking if cleaners turned up. Open your committee dashboard anytime to review live muster rolls, zone completion percentages, and monthly compliance packs.
              </p>
              <ul class="panel-features">
                <li><strong>Live Daily Headcount:</strong> See who is on-site with selfie and GPS verification.</li>
                <li><strong>Photo Task Log:</strong> Inspect timestamped proof of cleaned amenities and common areas.</li>
                <li><strong>One-Click Compliance Pack:</strong> Download PF/ESIC challans and wage slips for AGM audits.</li>
                <li><strong>Resident Issue Tracker:</strong> Log special requests or complaints and track resolution.</li>
              </ul>
              <div class="panel-cta">
                <a href="/for-societies" class="btn btn-primary">Explore Society Features →</a>
              </div>
            </div>
            <div class="panel-mockup">
              <div class="browser-window">
                <div class="browser-bar">
                  <div class="browser-dots">
                    <span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span>
                  </div>
                  <span class="browser-url">app.altsan.com/society/baner-meadows/attendance</span>
                </div>
                <div class="browser-body">
                  <div class="dash-stat-row">
                    <div class="dash-stat-box">
                      <span class="dash-label">Today's Headcount</span>
                      <span class="dash-value text-green">6 / 6 Present</span>
                      <span class="dash-hint">100% Roster Fulfilled</span>
                    </div>
                    <div class="dash-stat-box">
                      <span class="dash-label">Tasks Verified</span>
                      <span class="dash-value text-blue">14 / 16 Done</span>
                      <span class="dash-hint">2 In Progress</span>
                    </div>
                    <div class="dash-stat-box">
                      <span class="dash-label">Supervisor Audit</span>
                      <span class="dash-value text-purple">98.5% Score</span>
                      <span class="dash-hint">Audited 09:15 AM</span>
                    </div>
                  </div>
                  <div class="dash-log-card">
                    <div class="dash-log-header">
                      <span>Live Verified Activity Log</span>
                      <span class="dash-pulse-badge">● Live Updates</span>
                    </div>
                    <div class="dash-log-item">
                      <span class="dash-check">✓</span>
                      <span class="dash-task-title">Wing B Podium Washdown</span>
                      <span class="dash-time">08:15 AM</span>
                      <span class="dash-pill">📸 Proof Verified</span>
                    </div>
                    <div class="dash-log-item">
                      <span class="dash-check">✓</span>
                      <span class="dash-task-title">Main Entrance Glass Cleaning</span>
                      <span class="dash-time">08:45 AM</span>
                      <span class="dash-pill">📸 Proof Verified</span>
                    </div>
                    <div class="dash-log-item">
                      <span class="dash-check">✓</span>
                      <span class="dash-task-title">Clubhouse Gym Floor Mopping</span>
                      <span class="dash-time">09:10 AM</span>
                      <span class="dash-pill">📸 Proof Verified</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Panel 2: Worker App -->
        <div class="eco-panel" id="panel-worker" role="tabpanel" style="display: none;">
          <div class="panel-grid">
            <div class="panel-content">
              <div class="panel-badge">For On-Ground Cleaning Crew</div>
              <h3>Simple Hindi & English Guidance for Every Task</h3>
              <p>
                Our mobile application guides housekeepers step-by-step through their shift duties, removing language barriers and eliminating guesswork about which areas need attention.
              </p>
              <ul class="panel-features">
                <li><strong>One-Tap Geofence Check-in:</strong> Workers clock in only when physically inside the society.</li>
                <li><strong>Visual Task Checklists:</strong> Room-by-room tasks with clear Hindi/English instructions.</li>
                <li><strong>Native Camera Proof:</strong> Instant before/after photo submission with GPS tags.</li>
                <li><strong>Fair & Transparent Wages:</strong> Logged hours are clearly visible, ensuring dignified, on-time pay.</li>
              </ul>
              <div class="panel-cta">
                <a href="/how-it-works" class="btn btn-primary">See How Workers Use It →</a>
              </div>
            </div>
            <div class="panel-mockup">
              <div class="mini-app-card">
                <div class="mini-app-header">
                  <span>📱 Altsan Worker (हिंदी / English)</span>
                  <span class="badge-online">● Geofence Active</span>
                </div>
                <div class="mini-app-box">
                  <div class="mini-worker-banner">
                    <div class="avatar-circle">SK</div>
                    <div>
                      <div class="mini-title">Sunita Kamble (सुनीता कांबळे)</div>
                      <div class="mini-sub">Tower C & D Housekeeping Lead</div>
                    </div>
                  </div>
                  <div class="mini-duty-list">
                    <div class="mini-duty done">
                      <span class="mini-icon">✓</span>
                      <div>
                        <strong>लिफ्ट आणि लॉबी स्वच्छता (Lifts & Lobby)</strong>
                        <span>07:30 AM • छायाचित्र सत्यापित (Photo Verified)</span>
                      </div>
                    </div>
                    <div class="mini-duty done">
                      <span class="mini-icon">✓</span>
                      <div>
                        <strong>कचरा संकलन (Garbage Collection)</strong>
                        <span>08:15 AM • छायाचित्र सत्यापित (Photo Verified)</span>
                      </div>
                    </div>
                    <div class="mini-duty active">
                      <span class="mini-icon spin">⟳</span>
                      <div>
                        <strong>पायऱ्या पुसणे (Staircase Mopping)</strong>
                        <span>चालू आहे (In Progress • Photo Pending)</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Panel 3: Supervisor Command -->
        <div class="eco-panel" id="panel-supervisor" role="tabpanel" style="display: none;">
          <div class="panel-grid">
            <div class="panel-content">
              <div class="panel-badge">For Field Route Supervisors</div>
              <h3>Active Quality Assurance, Not Remote Promises</h3>
              <p>
                Our mobile route supervisors manage geographic clusters in Baner, Hinjawadi, and Wakad. Equipped with tablets, they conduct unannounced spot audits and mobilize standby relievers.
              </p>
              <ul class="panel-features">
                <li><strong>Surprise Route Audits:</strong> 25-point physical hygiene and sanitization scorecards.</li>
                <li><strong>15-Minute Reliever Mobilization:</strong> Immediate reassignment from nearby standby pools.</li>
                <li><strong>Chemical Dilution Checks:</strong> Enforces proper Diversey/Taski eco-safe standards.</li>
                <li><strong>Managing Committee Liaison:</strong> Physical weekly reviews with the estate manager.</li>
              </ul>
              <div class="panel-cta">
                <a href="/housekeeping" class="btn btn-primary">Review Supervisor Protocols →</a>
              </div>
            </div>
            <div class="panel-mockup">
              <div class="supervisor-dash-card">
                <div class="sup-card-header">
                  <span>🛡️ Route Supervisor Command (Baner Cluster)</span>
                  <span class="badge-active">Active Route</span>
                </div>
                <div class="sup-body">
                  <div class="sup-audit-box">
                    <div class="sup-audit-title">Morning Spot Audit Completed</div>
                    <div class="sup-audit-society">Baner Meadows CHS • 4 Towers</div>
                    <div class="sup-score">Hygiene Score: <strong>9.7 / 10</strong></div>
                  </div>
                  <div class="sup-reliever-box">
                    <div class="reliever-status-label">⚡ Standby Reliever Pool: 3 Available</div>
                    <div class="reliever-item">
                      <span>Worker on leave at Tower B &rarr; Reliever Rahul M. assigned</span>
                      <span class="badge-done">Arrived in 11m</span>
                    </div>
